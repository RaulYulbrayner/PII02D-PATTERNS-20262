<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="950"
            prefHeight="650"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.poo.pismartgym.viewController.ClienteViewController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="20" left="20" right="20"/>
            </padding>

            <Label text="Gestión de Clientes"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <GridPane hgap="10" vgap="10">

                <Label text="Documento:" GridPane.rowIndex="0"/>
                <TextField fx:id="txtDocumento"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Nombre completo:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="txtNombre"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0"/>

                <Label text="Teléfono:"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtTelefono"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Correo:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="txtCorreo"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

                <Label text="Edad:"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="txtEdad"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Fecha registro:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"/>

                <DatePicker fx:id="dpFechaRegistro"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="2"/>

            </GridPane>

            <HBox spacing="10">

                <Button text="Agregar"
                        onAction="#onAgregar"/>

                <Button text="Actualizar"
                        onAction="#onActualizar"/>

                <Button text="Eliminar"
                        onAction="#onEliminar"/>

                <Button text="Limpiar"
                        onAction="#onLimpiar"/>

                <Button text="Volver"
                        onAction="#onVolver"/>

            </HBox>

        </VBox>
    </top>

    <center>

        <TableView fx:id="tblClientes">

            <columns>

                <TableColumn fx:id="colDocumento"
                             text="Documento"
                             prefWidth="120"/>

                <TableColumn fx:id="colNombre"
                             text="Nombre"
                             prefWidth="200"/>

                <TableColumn fx:id="colTelefono"
                             text="Teléfono"
                             prefWidth="130"/>

                <TableColumn fx:id="colCorreo"
                             text="Correo"
                             prefWidth="200"/>

                <TableColumn fx:id="colEdad"
                             text="Edad"
                             prefWidth="70"/>

                <TableColumn fx:id="colFecha"
                             text="Registro"
                             prefWidth="130"/>

            </columns>

        </TableView>

    </center>

    <padding>
        <Insets bottom="20" left="20" right="20"/>
    </padding>

</BorderPane>
