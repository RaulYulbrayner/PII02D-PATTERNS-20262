<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="co.edu.uniquindio.poo.piitechsolutions.viewController.PrincipalViewController"
        prefWidth="1100.0"
        prefHeight="720.0"
        style="-fx-background-color: #f3f6fb;">

    <!-- Encabezado principal -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #000000;">

            <padding>
                <Insets top="20.0"
                        right="25.0"
                        bottom="20.0"
                        left="25.0"/>
            </padding>

            <VBox spacing="5.0">

                <Label
                        text="TechSolutions"
                        style="-fx-font-size: 26px;
                               -fx-font-weight: bold;
                               -fx-text-fill: white;"/>

                <Label
                        text="Sistema de gestión de servicios tecnológicos"
                        style="-fx-font-size: 13px;
                               -fx-text-fill: #cbd5e1;"/>

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label
                    text="PROGRAMACIÓN II"
                    style="-fx-font-size: 12px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #e2e8f0;"/>

        </HBox>
    </top>

    <!-- Menú de navegación -->
    <left>
        <VBox spacing="12.0"
              prefWidth="225.0"
              style="-fx-background-color: white;
                     -fx-border-color: #e2e8f0;
                     -fx-border-width: 0 1 0 0;">

            <padding>
                <Insets top="25.0"
                        right="15.0"
                        bottom="20.0"
                        left="15.0"/>
            </padding>

            <Label
                    text="MENÚ PRINCIPAL"
                    style="-fx-font-size: 12px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #64748b;"/>

            <Button
                    text="Servicios"
                    onAction="#mostrarServicios"
                    maxWidth="Infinity"
                    prefHeight="43.0"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: #e8f0fe;
                           -fx-text-fill: #1d4ed8;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-cursor: hand;"/>

            <Button
                    text="Paquetes tecnológicos"
                    onAction="#mostrarPaquetes"
                    maxWidth="Infinity"
                    prefHeight="43.0"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: #f1f5f9;
                           -fx-text-fill: #334155;
                           -fx-font-size: 14px;
                           -fx-cursor: hand;"/>

            <Button
                    text="Solicitudes"
                    onAction="#mostrarSolicitudes"
                    maxWidth="Infinity"
                    prefHeight="43.0"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: #f1f5f9;
                           -fx-text-fill: #334155;
                           -fx-font-size: 14px;
                           -fx-cursor: hand;"/>

            <Button
                    text="Técnicos"
                    onAction="#mostrarTecnicos"
                    maxWidth="Infinity"
                    prefHeight="43.0"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: #f1f5f9;
                           -fx-text-fill: #334155;
                           -fx-font-size: 14px;
                           -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label
                    text="TechSolutions"
                    style="-fx-font-size: 13px;
                           -fx-font-weight: bold;
                           -fx-text-fill: #475569;"/>

            <Label
                    text="Gestión centralizada de servicios"
                    wrapText="true"
                    style="-fx-font-size: 11px;
                           -fx-text-fill: #94a3b8;"/>

        </VBox>
    </left>

    <!-- Área para cargar las vistas -->
    <center>
        <StackPane
                fx:id="panelContenido"
                style="-fx-background-color: #f3f6fb;">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0"/>
            </padding>

        </StackPane>
    </center>

    <!-- Pie de página -->
    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-background-color: white;
                     -fx-border-color: #e2e8f0;
                     -fx-border-width: 1 0 0 0;">

            <padding>
                <Insets top="10.0"
                        right="20.0"
                        bottom="10.0"
                        left="20.0"/>
            </padding>

            <Label
                    text="TechSolutions | Ingeniería de Sistemas y Computación"
                    style="-fx-font-size: 11px;
                           -fx-text-fill: #64748b;"/>

        </HBox>
    </bottom>

</BorderPane>
